# Copy this file to `.env` and set your real values. Never commit `.env`.
#
#   cp Example.env .env
#
# Load into your shell (bash/zsh), then run ollama tools:
#   set -a && source .env && set +a
#
# Ollama web search / fetch: https://ollama.com/blog/web-search

OLLAMA_API_KEY=replace-with-your-ollama-api-key

# Optional — local chat defaults
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional — cap size of tool JSON passed back into chat (ollama_run --web-tools)
# OLLAMA_VAULT_TOOL_CHARS=12000
